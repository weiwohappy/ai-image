NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://viviai:viviai_dev_only@127.0.0.1:5432/viviai_dev
REDIS_URL=redis://127.0.0.1:6379
QUEUE_NAMESPACE=development
# Required in production: set an independent random value of at least 32 characters.
# CONTENT_CURSOR_SECRET=
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb

# Internal operations console A is OFF by default and refuses production activation.
# Read ADMIN.md before local-only activation. Never commit an actual encryption key.
ADMIN_ENABLED=false
# Optional local-only test allowlist (maximum 2 explicit emails); keep empty normally.
ADMIN_LOCAL_TEST_EMAILS=
# Explicit local-only password login for the above allowlist; MFA remains the default.
ADMIN_LOCAL_PASSWORD_LOGIN=false
ADMIN_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
# ADMIN_MFA_ENCRYPTION_KEY= # exactly 32 random bytes, canonical base64

# Development and test only. Production validation rejects these flags.
SIMULATION_PROVIDER_ENABLED=true
# Official models are OFF by default; configuration and credentials are server-only.
# Read OFFICIAL_MODELS.md before enabling or filling approved prices.
OFFICIAL_IMAGE_MODELS_JSON='{"revision":"disabled","accounts":{},"models":[]}'
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Third-party OpenAI-compatible chat provider (for example Sub2API). Disabled by default.
# In development, http://localhost:8080 is allowed; production requires HTTPS.
SUB2API_ENABLED=false
# SUB2API_BASE_URL=http://localhost:8080
# SUB2API_API_KEY= # server-only secret; never commit or expose to the browser
# SUB2API_MODEL_ID=gpt-5.1
# SUB2API_SCOPE=sub2api-default
# SUB2API_CREDENTIAL_VERSION=v1
# SUB2API_CONCURRENCY=1
# SUB2API_MAX_UNKNOWN=1
# SUB2API_DAILY_BUDGET_MICROS=0
# Optional OpenAI-compatible image channel on the same third-party account.
# Nano Banana uses the official Google channel; do not list Gemini IDs here unless the
# third-party service documents a compatible /v1/images/generations contract for them.
# SUB2API_DAILY_BUDGET_MICROS must be at least each model's reserveCostMicros here; a smaller
# budget (the default 0) makes startup refuse the image channel.
# SUB2API_IMAGE_MODELS_JSON='{"revision":"sub2api-images-v2","models":[{"modelId":"gpt-image-2","enabledResolutions":["1K","2K"],"reserveCostMicros":"1000000","pricing":{"version":"provider-cost-v1","currency":"USD","rates":{"input_text_tokens":"0","input_image_tokens":"0","output_image_tokens":"0"}}},{"modelId":"gpt-image-2.5-flare","enabledResolutions":["1K","2K"],"reserveCostMicros":"1000000","pricing":{"version":"provider-cost-v1","currency":"USD","rates":{"input_text_tokens":"0","input_image_tokens":"0","output_image_tokens":"0"}}},{"modelId":"gpt-image-2.5-sunburst","enabledResolutions":["1K","2K"],"reserveCostMicros":"1000000","pricing":{"version":"provider-cost-v1","currency":"USD","rates":{"input_text_tokens":"0","input_image_tokens":"0","output_image_tokens":"0"}}}]}'
DEV_MAIL_ENABLED=true
DEV_MAILBOX_ROOT=.data/mailbox
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=.data/private

# Required when NODE_ENV=production; production forbids development mailbox delivery.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=noreply@example.com
# Seed is manual: NODE_ENV=development npm run seed:dev
# Set DEV_SEED_EMAIL, DEV_SEED_USERNAME, DEV_SEED_PASSWORD in your shell.
# Password must be 12-128 characters; no default credentials.
# Optional DEV_SEED_CREDITS=1000 grants zero-revenue test credits (default 0).

# Use STORAGE_DRIVER=s3 outside local development.
# S3_BUCKET=viviai-private-assets
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=viviai_dev
# S3_SECRET_ACCESS_KEY=viviai_dev_only
# S3_FORCE_PATH_STYLE=true

# Payments are OFF until merchant onboarding, price approval and acceptance tests.
BILLING_ENABLED=false
WECHAT_PAY_ENABLED=false
ALIPAY_ENABLED=false
# BILLING_CATALOG_FILE=/absolute/private/billing-catalog.json
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_SERIAL=
# WECHAT_PAY_PRIVATE_KEY_FILE=/absolute/private/wechat-merchant.pem
# WECHAT_PAY_API_V3_KEY= # 32-byte secret supplied by secret manager, never commit
# WECHAT_PAY_PUBLIC_KEY_ID=
# WECHAT_PAY_PUBLIC_KEY_FILE=/absolute/private/wechat-platform-public.pem
# WECHAT_PAY_NOTIFY_URL=https://your-domain.example/api/webhooks/payments/wechat
# ALIPAY_APP_ID=
# ALIPAY_SELLER_ID=
# ALIPAY_PRIVATE_KEY_FILE=/absolute/private/alipay-app.pem
# ALIPAY_PUBLIC_KEY_FILE=/absolute/private/alipay-platform-public.pem
# ALIPAY_NOTIFY_URL=https://your-domain.example/api/webhooks/payments/alipay
# ALIPAY_RETURN_URL=https://your-domain.example/
