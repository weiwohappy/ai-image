{
  "name": "viviai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "npm run clean && prisma generate && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/src/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.check.json --noEmit",
    "format": "prettier --write src test scripts *.json *.ts README.md",
    "format:check": "prettier --check src test scripts *.json *.ts README.md",
    "smoke": "node scripts/smoke.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed:dev": "tsx src/scripts/seed-dev.ts",
    "admin:bootstrap": "tsx src/scripts/admin-bootstrap.ts",
    "pretest": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "alipay-sdk": "4.14.0",
    "bullmq": "6.3.4",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "alipay-sdk": {
      "urllib": "4.9.1"
    }
  }
}
